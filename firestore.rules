rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    // Retired after the account-service migration. Original records are retained
    // for rollback; public clients must use the authenticated community API.
    match /posts/{postId} {
      allow read, write: if false;
      match /{document=**} { allow read, write: if false; }
    }
    match /blogComments/{commentId} {
      allow read, write: if false;
    }
    // Existing unrelated collection policies retained from the published rules.
    match /vendorPosts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }
    match /reports/{reportId} {
      allow read: if admin();
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
    }
    match /caseStudySubmissions/{subId} {
      allow read: if false;
      allow create: if request.auth != null;
    }
    match /academyProfiles/{uid} { allow read, write: if false; }
    match /academyOrgScores/{orgSlug} { allow read, write: if false; }
  }
}
